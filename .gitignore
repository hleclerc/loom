# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/

# compilation outputs ( loom writes everything it generates under `build/`, see
# `compilation/build.py`: a common graph and one directory per kernel )
build/
*.o
*.a
*.so
*.so.p
*.dylib
compile_commands.json

# the runner ( errand )
.errand/
runs/

# misc
tmp/
.cache/

# the docs site ( vitepress ): keep its config and theme, not its dependencies nor its builds
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
.pytest_cache/
